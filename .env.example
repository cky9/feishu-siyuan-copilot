# Feishu Credentials
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret

# SiYuan Note Kernel
SIYUAN_API_URL=http://127.0.0.1:6806
SIYUAN_TOKEN=your_siyuan_token
SIYUAN_NOTEBOOK_ID=your_notebook_id

# LLM Providers
SILICONFLOW_API_KEY=sk-your_siliconflow_key
DEEPSEEK_API_KEY=sk-your_deepseek_key
ZHIPU_API_KEY=your_zhipu_key

# Vector Database Path (Optional: defaults to ~/.local_vectors/knowledge.db)
# VECTOR_DB_PATH=/path/to/custom/knowledge.db
